s=\"mord mtight\">∞</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.2671em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3414em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">n</span><span class=\"mclose\">!</span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\">x</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6644em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">n</span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.686em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span></span>","enumerator":"1","key":"EVndTwtRSV"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"provides a direct view of convergence and truncation error.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"wReBzSnbfZ"}],"key":"K9xMMhsrbO"}],"key":"qx2x19cBUG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\nimport numpy as np\nimport matplotlib.pyplot as plt\n\nx = np.linspace(-3, 3, 500)\n\ndef exp_partial_sum(x, order):\n    result = np.zeros_like(x, dtype=float)\n    for n in range(order + 1):\n        result += x**n / math.factorial(n)\n    return result\n\nfig, axes = plt.subplots(1, 2, figsize=(10, 4))\nfor order in (1, 2, 4, 8, 14):\n    approximation = exp_partial_sum(x, order)\n    axes[0].plot(x, approximation, label=f\"N={order}\")\n    axes[1].semilogy(x, np.maximum(np.abs(np.exp(x) - approximation), 1e-16), label=f\"N={order}\")\n\naxes[0].plot(x, np.exp(x), \"k--\", linewidth=2, label=\"$e^x$\")\naxes[0].set(xlabel=\"$x$\", ylabel=\"value\", title=\"Taylor approximations\")\naxes[1].set(xlabel=\"$x$\", ylabel=\"absolute error\", title=\"Truncation error\")\nfor ax in axes:\n    ax.grid(alpha=0.25)\n    ax.legend(frameon=False)\nfig.tight_layout()\nplt.show()","key":"kUDr9nRXqJ"},{"type":"outputs","id":"4jWIV7LgpXmwTFvZCVMrc","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"6f688ce15034589c2298ee9bebda5bce","path":"/chm696-site/build/6f688ce15034589c2298ee9bebda5bce.png"}}},"key":"yJZIHJ6aBM"}],"key":"p46hlGYQIJ"}],"key":"JcXhTATB4r"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Powers in the complex plane","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"fHwo7ytRZE"}],"identifier":"powers-in-the-complex-plane","label":"Powers in the complex plane","html_id":"powers-in-the-complex-plane","implicit":true,"key":"uxYV6atJfK"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":51,"column":1}},"children":[{"type":