h=0.8)\nax.axvline(0, color=\"0.7\", linewidth=0.8)\nax.set(aspect=\"equal\", xlabel=\"real part\", ylabel=\"imaginary part\", title=\"The map $z\\\\mapsto z^3$\")\nax.legend(frameon=False)\nplt.show()","key":"sR0UT5D8hx"},{"type":"outputs","id":"TJM3iqtFYM03eRqnDetBq","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 500x500 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"5f2d6e7826a2e435ef64414a87423147","path":"/chm696-site/build/5f2d6e7826a2e435ef64414a87423147.png"}}},"key":"hEHDNqPfus"}],"key":"iVC0gzRSOE"}],"key":"wrwYFoyexr"}],"key":"E8cFcH571w"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Computational notebooks","url":"/computations","group":"Computational notebooks"},"next":{"title":"Linear algebra with Python","url":"/computations/linear-algebra","group":"Computational notebooks"}}},"domain":"http://localhost:3000"}