10, 4))\naxes[0].plot(t, x)\naxes[0].set(xlabel=\"time\", ylabel=\"$x(t)$\", title=\"Driven response\")\naxes[1].plot(x, velocity)\naxes[1].set(xlabel=\"$x$\", ylabel=\"$\\\\dot{x}$\", title=\"Phase portrait\")\nfig.tight_layout()\nplt.show()","key":"V0uheDWleE"},{"type":"outputs","id":"pNNIg2dynchjj2opYpqUl","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"e7b789ea2394fa235b27d3b6bcfbfc38","path":"/chm696-site/build/e7b789ea2394fa235b27d3b6bcfbfc38.png"}}},"key":"AMgIL3iWyH"}],"key":"TCVsQUXNDU"}],"key":"KVQMlIlDLI"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Sturm-Liouville modes and diffusion","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"FxCI6wlwmh"}],"identifier":"sturm-liouville-modes-and-diffusion","label":"Sturm-Liouville modes and diffusion","html_id":"sturm-liouville-modes-and-diffusion","implicit":true,"key":"vr9cFf78QW"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"For homogeneous Dirichlet boundaries on ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"H0lyLXeYtT"},{"type":"inlineMath","value":"0\\leq x\\leq 1","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">0\\leq x\\leq 1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7804em;vertical-align:-0.13