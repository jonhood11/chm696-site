\ntimes = (0.0, 0.005, 0.02, 0.08)\ncoefficients = {1: 1.0, 3: 0.55, 7: -0.25}\n\nfig, ax = plt.subplots(figsize=(7, 4))\nfor current_time in times:\n    field = sum(amplitude*np.sin(n*np.pi*xgrid)*np.exp(-(n*np.pi)**2*current_time)\n                for n, amplitude in coefficients.items())\n    ax.plot(xgrid, field, label=f\"t={current_time:g}\")\nax.set(xlabel=\"$x$\", ylabel=\"$u(x,t)$\", title=\"Diffusion as modal damping\")\nax.legend(frameon=False)\nax.grid(alpha=0.2)\nplt.show()","key":"b9PgbQiEOq"},{"type":"outputs","id":"dRtqXb1upj71Z2MTdJvRU","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 700x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"dca182015707eb9dfd73912135c673ad","path":"/chm696-site/build/dca182015707eb9dfd73912135c673ad.png"}}},"key":"b6HKNGchTy"}],"key":"khFZJkkdZk"}],"key":"QhLQm0rjkQ"}],"key":"oBpHtCrYfK"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Fourier analysis with Python","url":"/computations/fourier-analysis","group":"Computational notebooks"},"next":{"title":"Complex analysis with Python","url":"/computations/complex-analysis","group":"Computational notebooks"}}},"domain":"http://localhost:3000"}