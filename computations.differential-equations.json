{"version":3,"kind":"Notebook","sha256":"2a03a471ebe7cd092fd96d491b5b3235cdbf6fe884db334b127d1a4a1a3a2eb2","slug":"computations.differential-equations","location":"/computations/differential-equations.md","dependencies":[],"frontmatter":{"title":"Differential equations with Python","kernelspec":{"name":"python3","display_name":"Python 3"},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Jonathan Hood","given":"Jonathan","family":"Hood"},"name":"Jonathan Hood","affiliations":["Purdue University"],"id":"contributors-myst-generated-uid-0"}],"keywords":["chemistry","mathematical methods","scientific computing","purdue"],"affiliations":[{"id":"Purdue University","name":"Purdue University"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"differential-equations.md","url":"/chm696-site/build/differential-equatio-df840a4736fa979ee51cecd57db13aa6.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"A damped, driven oscillator","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"PgYGD5ut9Y"}],"identifier":"a-damped-driven-oscillator","label":"A damped, driven oscillator","html_id":"a-damped-driven-oscillator","implicit":true,"key":"tkv7B3AFZ5"}],"key":"vqcrnxFn3A"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.integrate import solve_ivp\n\ndef oscillator(t, state, damping=0.25, drive=0.8, omega=1.15):\n    x, velocity = state\n    return velocity, -damping*velocity - x + drive*np.cos(omega*t)\n\nsolution = solve_ivp(oscillator, (0, 60), (0, 0), max_step=0.04, dense_output=True)\nt = np.linspace(0, 60, 1800)\nx, velocity = solution.sol(t)\n\nfig, axes = plt.subplots(1, 2, figsize=(10, 4))\naxes[0].plot(t, x)\naxes[0].set(xlabel=\"time\", ylabel=\"$x(t)$\", title=\"Driven response\")\naxes[1].plot(x, velocity)\naxes[1].set(xlabel=\"$x$\", ylabel=\"$\\\\dot{x}$\", title=\"Phase portrait\")\nfig.tight_layout()\nplt.show()","key":"pflWXQdGyg"},{"type":"outputs","id":"L-jFMJRfPYrg1Pklnxyyp","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"e7b789ea2394fa235b27d3b6bcfbfc38","path":"/chm696-site/build/e7b789ea2394fa235b27d3b6bcfbfc38.png"}}},"key":"MCVNg4q6fp"}],"key":"wVQHvSOj6N"}],"key":"VBa71wFBVd"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Sturm-Liouville modes and diffusion","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"xCT37VIEcn"}],"identifier":"sturm-liouville-modes-and-diffusion","label":"Sturm-Liouville modes and diffusion","html_id":"sturm-liouville-modes-and-diffusion","implicit":true,"key":"uOC4Qr0Ish"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"For homogeneous Dirichlet boundaries on ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"FhiD35NAV3"},{"type":"inlineMath","value":"0\\leq x\\leq 1","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">0\\leq x\\leq 1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7804em;vertical-align:-0.136em;\"></span><span class=\"mord\">0</span><span class