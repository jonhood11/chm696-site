{"version":3,"kind":"Notebook","sha256":"4602fdcc04056717f08d8b3582a4f0320529f02283f2466d17e5fe5d1744c8ac","slug":"resources.python-plotting","location":"/resources/python-plotting.md","dependencies":[],"frontmatter":{"title":"Python plotting demonstration","kernelspec":{"name":"python3","display_name":"Python 3"},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Jonathan Hood","given":"Jonathan","family":"Hood"},"name":"Jonathan Hood","affiliations":["Purdue University"],"id":"contributors-myst-generated-uid-0"}],"keywords":["chemistry","mathematical methods","scientific computing","purdue"],"affiliations":[{"id":"Purdue University","name":"Purdue University"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"python-plotting.md","url":"/chm696-site/build/python-plotting-351433b98f456a6dabc7aafa79fcb61d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"This page verifies that Python executes when the website is built. The first figure is generated with Matplotlib and embedded as a static image. The second is generated with Plotly and remains interactive in the published website.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"VjuvpQyb35"}],"key":"hiCTFtbXbf"},{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Matplotlib","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"aM27QAHOB4"}],"identifier":"matplotlib","label":"Matplotlib","html_id":"matplotlib","implicit":true,"key":"ww2M9vw7ip"}],"key":"Om9wbkX2y7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\nx = np.linspace(-4, 4, 500)\ny1 = np.exp(-((x + 1.1) ** 2) / 0.8)\ny2 = 0.72 * np.exp(-((x - 1.2) ** 2) / 1.3)\n\nfig, ax = plt.subplots(figsize=(7, 4))\nax.plot(x, y1, color=\"#cfb991\", linewidth=2.5, label=\"Signal A\")\nax.plot(x, y2, color=\"#8e6f3e\", linewidth=2.5, label=\"Signal B\")\nax.set(xlabel=\"Coordinate\", ylabel=\"Intensity\", title=\"Python-generated figure\")\nax.legend(frameon=False)\nax.spines[[\"top\", \"right\"]].set_visible(False)\nplt.show()","visibility":"hide","key":"hDMjs0xkjG"},{"type":"outputs","id":"_Ob5MqqKX_9iUjewCLnjq","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 700x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"6fb02638bcd3bdb75cdab78ad65c0d84","path":"/chm696-site/build/6fb02638bcd3bdb75cdab78ad65c0d84.png"}}},"key":"tXtRRB2b6j"}],"visibility":"show","key":"R1nbo95rGp"}],"data":{"tags":[]},"visibility":"show","key":"DP2VmmAKsr"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Interactive Plotly figure","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"qFcFxyMBt9"}],"identifier":"interactive-plotly-figure","label":"Interactive Plotly figure","html_id":"interactive-plotly-figure","implicit":true,"key":"hP6ykLZzyV"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Use the toolbar to zoom, pan, and inspect the curves.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"V2NXE4CHFS"}],"key":"dnNZoDMnmG"}],"key":"Am9kzYdaS6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import plotly.graph_objects as go\n\nfigure = go.Figure()\nfigure.add_scatter(x=x, y=y1, mode=\"lines\", name=\"Signal A\")\nfigure.add_scatter(x=x, y=y2, mode=\"lines\", name=\"Signal B\")\nfigure.update_layout(\n    title=\"Interactive Python-generated figure\",\n    xaxis_title=\"Coordinate\",\n    yaxis_title=\"Intensity\",\n    template=\"plotly_white\",\n)\nfigure.show()","visibility":"hide","key":"dJfBRRaMnZ"},{"type":"outputs","id":"1SEyU5EmuGnh2tV3QygAZ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"application/vnd.plotly.v1+json":{"content_type":"application/vnd.plotly.v1+json","hash":"50e9b59613b264346f366457280308c5","path":"/chm696-site/build/50e9b59613b264346f366457280308c5.json"}}},"key":"fZSNmvaRSq"}],"visibility":"show","key":"LLotRBIw3X"}],"data":{"tags":[]},"visibility":"show","key":"UEVIQXV20e"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"The Python code above runs during the Jupyter Book build. Plotly supplies browser-side interaction after the page has been published; no Python server is required for students to view it.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"fUvpC1MBFs"}],"key":"tJ4oxbQSyN"}],"key":"J7JvhHDWxY"}],"key":"mJIBvCFUu7"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Resources","url":"/resources","group":"Resources"}}},"domain":"http://localhost:3000"}