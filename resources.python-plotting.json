{"version":3,"kind":"Notebook","sha256":"123a7cca0606f8df263dcf9952410064750284eb1c4e655a4aaa2e2e2a6ac864","slug":"resources.python-plotting","location":"/resources/python-plotting.md","dependencies":[],"frontmatter":{"title":"Python plotting demonstration","kernelspec":{"name":"python3","display_name":"Python 3"},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Jonathan Hood","given":"Jonathan","family":"Hood"},"name":"Jonathan Hood","affiliations":["Purdue University"],"id":"contributors-Users\\jonho\\GitHub\\Purdue\\Teaching\\CHM696\\site\\myst-generated-uid-0"}],"keywords":["chemistry","purdue"],"affiliations":[{"id":"Purdue University","name":"Purdue University"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"python-plotting.md","url":"/chm696-site/build/python-plotting-d92bcdb1a43c1d3b54f604643878883a.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"This page verifies that Python executes when the website is built. The first figure is generated with Matplotlib and embedded as a static image. The second is generated with Plotly and remains interactive in the published website.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"P56QpbavJ6"}],"key":"WzU88rpkxH"},{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Matplotlib","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"N7Ve3wbw7I"}],"identifier":"matplotlib","label":"Matplotlib","html_id":"matplotlib","implicit":true,"key":"teDJcHfl5m"}],"key":"WWEnVF2WWL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\nx = np.linspace(-4, 4, 500)\ny1 = np.exp(-((x + 1.1) ** 2) / 0.8)\ny2 = 0.72 * np.exp(-((x - 1.2) ** 2) / 1.3)\n\nfig, ax = plt.subplots(figsize=(7, 4))\nax.plot(x, y1, color=\"#cfb991\", linewidth=2.5, label=\"Signal A\")\nax.plot(x, y2, color=\"#8e6f3e\", linewidth=2.5, label=\"Signal B\")\nax.set(xlabel=\"Coordinate\", ylabel=\"Intensity\", title=\"Python-generated figure\")\nax.legend(frameon=False)\nax.spines[[\"top\", \"right\"]].set_visible(False)\nplt.show()","visibility":"hide","key":"vSRhGXPUss"},{"type":"outputs","id":"Ehc6HVBdA8LuLmFSb6sp3","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"Matplotlib is building the font cache; this may take a moment.\n"},"key":"YGHEJcsxtR"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 700x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"6fb02638bcd3bdb75cdab78ad65c0d84","path":"/chm696-site/build/6fb02638bcd3bdb75cdab78ad65c0d84.png"}}},"key":"OyPkyCbi9b"}],"visibility":"show","key":"Tp1cHMMByF"}],"data":{"tags":[]},"visibility":"show","key":"nGvc39IkR8"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Interactive Plotly figure","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"NjPuOVmy6j"}],"identifier":"interactive-plotly-figure","label":"Interactive Plotly figure","html_id":"interactive-plotly-figure","implicit":true,"key":"m49rOlGuaK"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Use the toolbar to zoom, pan, and inspect the curves.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ATD6xU8dNm"}],"key":"MenfeZxDEb"}],"key":"JyQuXfCZau"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import plotly.graph_objects as go\n\nfigure = go.Figure()\nfigure.add_scatter(x=x, y=y1, mode=\"lines\", name=\"Signal A\")\nfigure.add_scatter(x=x, y=y2, mode=\"lines\", name=\"Signal B\")\nfigure.update_layout(\n    title=\"Interactive Python-generated figure\",\n    xaxis_title=\"Coordinate\",\n    yaxis_title=\"Intensity\",\n    template=\"plotly_white\",\n)\nfigure.show()","visibility":"hide","key":"P7J9ddfNHN"},{"type":"outputs","id":"8ltGkLXhrR1xZtrueSU5k","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"application/vnd.plotly.v1+json":{"content_type":"application/vnd.plotly.v1+json","hash":"97610653c9bd16359b9afa580e37cf70","path":"/chm696-site/build/97610653c9bd16359b9afa580e37cf70.json"}}},"key":"bX81r9Xr2O"}],"visibility":"show","key":"QVq2EYubNN"}],"data":{"tags":[]},"visibility":"show","key":"BDg8VadKd0"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"The Python code above runs during the Jupyter Book build. Plotly supplies browser-side interaction after the page has been published; no Python server is required for students to view it.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"UDZO46qawX"}],"key":"KFDWIPTTyd"}],"key":"WlFROQJJFz"}],"key":"UqoahqDo9C"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Resources","url":"/resources","group":"Resources"}}},"domain":"http://localhost:3000"}