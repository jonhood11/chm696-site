{"version":3,"kind":"Notebook","sha256":"68a50febf23cf86c1eaf91f6f3798ce2f943ac03562cccb9e223e3bf22484832","slug":"computations.machine-learning","location":"/computations/machine-learning.md","dependencies":[],"frontmatter":{"title":"Machine learning with Python","kernelspec":{"name":"python3","display_name":"Python 3"},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Jonathan Hood","given":"Jonathan","family":"Hood"},"name":"Jonathan Hood","affiliations":["Purdue University"],"id":"contributors-myst-generated-uid-0"}],"keywords":["chemistry","mathematical methods","scientific computing","purdue"],"affiliations":[{"id":"Purdue University","name":"Purdue University"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"machine-learning.md","url":"/chm696-site/build/machine-learning-bf032c9eda8212604020d7640e2ce87a.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Linear regression and model complexity","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"FXS5v6hnAE"}],"identifier":"linear-regression-and-model-complexity","label":"Linear regression and model complexity","html_id":"linear-regression-and-model-complexity","implicit":true,"key":"f9EQAjGFxZ"}],"key":"BzYk0itHbp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\nrng = np.random.default_rng(696)\nx = np.linspace(-2, 2, 55)\ny = 0.6 - 1.1*x + 0.75*x**2 + rng.normal(0, 0.45, x.size)\n\nfig, ax = plt.subplots(figsize=(7, 4))\nax.scatter(x, y, color=\"k\", s=18, label=\"data\")\nfor degree in (1, 2, 12):\n    coefficients = np.polyfit(x, y, degree)\n    ax.plot(x, np.polyval(coefficients, x), label=f\"degree {degree}\")\nax.set(xlabel=\"$x$\", ylabel=\"$y$\", title=\"Underfitting, a useful model, and overfitting\")\nax.legend(frameon=False)\nplt.show()","key":"F2CK883NqB"},{"type":"outputs","id":"e01GtXkNDCl4qpBHd4Ffz","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 700x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"5bff1f3e5c67a42082be6c70773c5fa7","path":"/chm696-site/build/5bff1f3e5c67a42082be6c70773c5fa7.png"}}},"key":"JVE3NxFDnl"}],"key":"hkQM5u9Pci"}],"key":"vpe1eDUpeG"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"K-means clustering from first principles","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Yw7eHEsrlW"}],"identifier":"k-means-clustering-from-first-principles","label":"K-means clustering from first principles","html_id":"k-means-clustering-from-first-principles","implicit":true,"key":"QpcYwOsAWK"}],"key":"mI0O03Nx5B"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"clouds = np.vstack([\n    rng.normal((-1.4, -0.4), (0.45, 0.35), size=(90, 2)),\n    rng.normal((1.1, -0.2), (0.4, 0.5), size=(90, 2)),\n    rng.normal((0.1, 1.45), (0.5, 0.35), size=(90, 2)),\n])\ncenters = clouds[[5, 105, 205]].copy()\n\nfor _ in range(25):\n    distances = np.linalg.norm(clouds[:, None, :] - centers[None, :, :], axis=2)\n    labels = np.argmin(distances, axis=1)\n    new_centers = np.vstack([clouds[labels == k].mean(axis=0) for k in range(3)])\n    if np.allclose(new_centers, centers):\n        break\n    centers = new_centers\n\nfig, ax = plt.subplots(figsize=(6, 5))\nax.scatter(clouds[:, 0], clouds[:, 1], c=labels, cmap=\"viridis\", s=18)\nax.scatter(centers[:, 0], centers[:, 1], c=\"red\", marker=\"X\", s=180, label=\"centers\")\nax.set(xlabel=\"feature 1\", ylabel=\"feature 2\", title=\"K-means clustering\")\nax.legend(frameon=False)\nplt.show()","key":"RHXGWKVNHP"},{"type":"outputs","id":"f07eQpVrqeli3_Xlz1LRc","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 600x500 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"5bfa8faefa360f5466ddb4e24a11b0fc","path":"/chm696-site/build/5bfa8faefa360f5466ddb4e24a11b0fc.png"}}},"key":"D8tTGn0X2b"}],"key":"G0hO413TTv"}],"key":"v1O6Po589m"}],"key":"yRnVC3eHjo"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Monte Carlo and Markov processes with Python","url":"/computations/monte-carlo","group":"Computational notebooks"},"next":{"title":"Assignments and projects","url":"/assignments","group":"Assignments and projects"}}},"domain":"http://localhost:3000"}