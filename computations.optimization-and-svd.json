{"version":3,"kind":"Notebook","sha256":"1e224f37a0904640f182ddcb5044065e292f53f66a9f51591f1dd4107430a6d7","slug":"computations.optimization-and-svd","location":"/computations/optimization-and-svd.md","dependencies":[],"frontmatter":{"title":"Optimization and singular value decomposition","kernelspec":{"name":"python3","display_name":"Python 3"},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Jonathan Hood","given":"Jonathan","family":"Hood"},"name":"Jonathan Hood","affiliations":["Purdue University"],"id":"contributors-myst-generated-uid-0"}],"keywords":["chemistry","mathematical methods","scientific computing","purdue"],"affiliations":[{"id":"Purdue University","name":"Purdue University"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"optimization-and-svd.md","url":"/chm696-site/build/optimization-and-svd-45c49e80026b23c50c04b42064042f4d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Gradient descent on a quadratic form","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"cnCH482RfD"}],"identifier":"gradient-descent-on-a-quadratic-form","label":"Gradient descent on a quadratic form","html_id":"gradient-descent-on-a-quadratic-form","implicit":true,"key":"XLa4pStdhD"}],"key":"mvwdzuwOqh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\nH = np.array([[5.0, 1.5], [1.5, 1.2]])\nb = np.array([-1.0, 0.5])\n\ndef objective(x):\n    return 0.5 * x @ H @ x + b @ x\n\nx = np.array([2.0, -2.0])\npath = [x.copy()]\nstep = 0.18\nfor _ in range(30):\n    x = x - step * (H @ x + b)\n    path.append(x.copy())\npath = np.array(path)\n\ngx = np.linspace(-2.5, 2.5, 250)\ngy = np.linspace(-2.5, 2.5, 250)\nX, Y = np.meshgrid(gx, gy)\nZ = np.array([[objective(np.array([xx, yy])) for xx in gx] for yy in gy])\n\nfig, ax = plt.subplots(figsize=(6, 5))\nax.contour(X, Y, Z, levels=22, cmap=\"viridis\")\nax.plot(path[:, 0], path[:, 1], \"o-\", color=\"tab:red\", markersize=3, label=\"gradient descent\")\nax.set(xlabel=\"$x_1$\", ylabel=\"$x_2$\", title=\"Optimization path\")\nax.legend(frameon=False)\nplt.show()","key":"WNBjxDTdRx"},{"type":"outputs","id":"O2P3UdB6NIePPovxM4MJr","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 600x500 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"fb533fb4da0119f5c677759faecd656d","path":"/chm696-site/build/fb533fb4da0119f5c677759faecd656d.png"}}},"key":"bjPFy1T4aM"}],"key":"x1ZpPKe3Cf"}],"key":"Pls77glD8b"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Low-rank approximation","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"tpqPl7nedY"}],"identifier":"low-rank-approximation","label":"Low-rank approximation","html_id":"low-rank-approximation","implicit":true,"key":"NrDMBO8Usg"}],"key":"gg2NGMEaTx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"t = np.linspace(0, 2*np.pi, 140)\nM = (np.sin(t)[:, None] * np.cos(2*t)[None, :]\n     + 0.35*np.cos(3*t)[:, None] * np.sin(t)[None, :])\nU, singular_values, Vh = np.linalg.svd(M, full_matrices=False)\n\nfig, axes = plt.subplots(1, 3, figsize=(11, 3.5))\naxes[0].imshow(M, cmap=\"coolwarm\", aspect=\"auto\")\naxes[0].set_title(\"Original matrix\")\nfor ax, rank in zip(axes[1:], (1, 2)):\n    approximation = (U[:, :rank] * singular_values[:rank]) @ Vh[:rank]\n    ax.imshow(approximation, cmap=\"coolwarm\", aspect=\"auto\")\n    ax.set_title(f\"Rank-{rank} approximation\")\nfor ax in axes:\n    ax.set(xticks=[], yticks=[])\nfig.tight_layout()\nplt.show()\n\nsingular_values[:6]","key":"Y0RAIeqDR4"},{"type":"outputs","id":"y0TQybj96E3VTZCkEjQuP","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1100x350 with 3 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"b40afcf73e5cd12d6b53962dfd3f26d9","path":"/chm696-site/build/b40afcf73e5cd12d6b53962dfd3f26d9.png"}}},"key":"U67gEOcJon"},{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"text/plain":{"content":"array([6.99982143e+01, 2.44993750e+01, 3.01104413e-14, 2.77339557e-14,\n       2.54082708e-14, 2.09949188e-14])","content_type":"text/plain"}}},"key":"LQPVY67KG5"}],"key":"Fqww7RQtjz"}],"key":"tPoHd6hxv9"}],"key":"kvZoCNr3R3"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Linear algebra with Python","url":"/computations/linear-algebra","group":"Computational notebooks"},"next":{"title":"Fourier analysis with Python","url":"/computations/fourier-analysis","group":"Computational notebooks"}}},"domain":"http://localhost:3000"}