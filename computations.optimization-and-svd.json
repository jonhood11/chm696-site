{"version":3,"kind":"Notebook","sha256":"1e224f37a0904640f182ddcb5044065e292f53f66a9f51591f1dd4107430a6d7","slug":"computations.optimization-and-svd","location":"/computations/optimization-and-svd.md","dependencies":[],"frontmatter":{"title":"Optimization and singular value decomposition","kernelspec":{"name":"python3","display_name":"Python 3"},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Jonathan Hood","given":"Jonathan","family":"Hood"},"name":"Jonathan Hood","affiliations":["Purdue University"],"id":"contributors-Users\\jonho\\GitHub\\Purdue\\Teaching\\CHM696\\site\\myst-generated-uid-0"}],"keywords":["chemistry","mathematical methods","scientific computing","purdue"],"affiliations":[{"id":"Purdue University","name":"Purdue University"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"optimization-and-svd.md","url":"/chm696-site/build/optimization-and-svd-21372755268f95b6bde8014dacf3f62d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Gradient descent on a quadratic form","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"SYuxCEn4CT"}],"identifier":"gradient-descent-on-a-quadratic-form","label":"Gradient descent on a quadratic form","html_id":"gradient-descent-on-a-quadratic-form","implicit":true,"key":"tw8HLTNWcj"}],"key":"LkwpeAuvrZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\nH = np.array([[5.0, 1.5], [1.5, 1.2]])\nb = np.array([-1.0, 0.5])\n\ndef objective(x):\n    return 0.5 * x @ H @ x + b @ x\n\nx = np.array([2.0, -2.0])\npath = [x.copy()]\nstep = 0.18\nfor _ in range(30):\n    x = x - step * (H @ x + b)\n    path.append(x.copy())\npath = np.array(path)\n\ngx = np.linspace(-2.5, 2.5, 250)\ngy = np.linspace(-2.5, 2.5, 250)\nX, Y = np.meshgrid(gx, gy)\nZ = np.array([[objective(np.array([xx, yy])) for xx in gx] for yy in gy])\n\nfig, ax = plt.subplots(figsize=(6, 5))\nax.contour(X, Y, Z, levels=22, cmap=\"viridis\")\nax.plot(path[:, 0], path[:, 1], \"o-\", color=\"tab:red\", markersize=3, label=\"gradient descent\")\nax.set(xlabel=\"$x_1$\", ylabel=\"$x_2$\", title=\"Optimization path\")\nax.legend(frameon=False)\nplt.show()","key":"XLDA5n9G1V"},{"type":"outputs","id":"OGIuLUjw6UnLjNYYa3hKX","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 600x500 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"4f6939e01b7bc0074a411d3efc5ea6d8","path":"/chm696-site/build/4f6939e01b7bc0074a411d3efc5ea6d8.png"}}},"key":"qFqdxtlvlH"}],"key":"GswGdaZVbZ"}],"key":"cCBtrY77mr"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Low-rank approximation","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"ghpnQyvlaa"}],"identifier":"low-rank-approximation","label":"Low-rank approximation","html_id":"low-rank-approximation","implicit":true,"key":"EdqYOnM9SJ"}],"key":"YN0O2BFY2a"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"t = np.linspace(0, 2*np.pi, 140)\nM = (np.sin(t)[:, None] * np.cos(2*t)[None, :]\n     + 0.35*np.cos(3*t)[:, None] * np.sin(t)[None, :])\nU, singular_values, Vh = np.linalg.svd(M, full_matrices=False)\n\nfig, axes = plt.subplots(1, 3, figsize=(11, 3.5))\naxes[0].imshow(M, cmap=\"coolwarm\", aspect=\"auto\")\naxes[0].set_title(\"Original matrix\")\nfor ax, rank in zip(axes[1:], (1, 2)):\n    approximation = (U[:, :rank] * singular_values[:rank]) @ Vh[:rank]\n    ax.imshow(approximation, cmap=\"coolwarm\", aspect=\"auto\")\n    ax.set_title(f\"Rank-{rank} approximation\")\nfor ax in axes:\n    ax.set(xticks=[], yticks=[])\nfig.tight_layout()\nplt.show()\n\nsingular_values[:6]","key":"v27JhTfSG7"},{"type":"outputs","id":"nEAfAxDapGWmJzrZ556B6","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1100x350 with 3 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"f8c6b29b93bb3f4df24fd9e95ad9fa66","path":"/chm696-site/build/f8c6b29b93bb3f4df24fd9e95ad9fa66.png"}}},"key":"QRkEbkoGno"},{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"text/plain":{"content":"array([6.99982143e+01, 2.44993750e+01, 3.40095463e-14, 2.33576641e-14,\n       2.20467177e-14, 2.13717598e-14])","content_type":"text/plain"}}},"key":"ZoiNEcIyYR"}],"key":"GhSjkASj12"}],"key":"lZypYVZXLs"}],"key":"r9bBVI98S7"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Linear algebra with Python","url":"/computations/linear-algebra","group":"Computational notebooks"},"next":{"title":"Fourier analysis with Python","url":"/computations/fourier-analysis","group":"Computational notebooks"}}},"domain":"http://localhost:3000"}