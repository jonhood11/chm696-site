{"version":3,"kind":"Notebook","sha256":"e1a023d6c5c4756bf0ff68eab939f051e8df97486b7f9a35ce4c4dbaf5e7c5ce","slug":"computations.monte-carlo","location":"/computations/monte-carlo.md","dependencies":[],"frontmatter":{"title":"Monte Carlo and Markov processes with Python","kernelspec":{"name":"python3","display_name":"Python 3"},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Jonathan Hood","given":"Jonathan","family":"Hood"},"name":"Jonathan Hood","affiliations":["Purdue University"],"id":"contributors-myst-generated-uid-0"}],"keywords":["chemistry","mathematical methods","scientific computing","purdue"],"affiliations":[{"id":"Purdue University","name":"Purdue University"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"monte-carlo.md","url":"/chm696-site/build/monte-carlo-c8b4e7c94a303b98de501de9a0325662.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Monte Carlo estimation","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"LZkRohRkjn"}],"identifier":"monte-carlo-estimation","label":"Monte Carlo estimation","html_id":"monte-carlo-estimation","implicit":true,"key":"RiZ1bXxZ5t"}],"key":"YkTK9qJcUA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\nrng = np.random.default_rng(696)\npoints = rng.uniform(-1, 1, size=(60000, 2))\ninside = np.sum(points**2, axis=1) <= 1\nrunning_pi = 4*np.cumsum(inside) / np.arange(1, inside.size + 1)\n\nfig, axes = plt.subplots(1, 2, figsize=(10, 4))\naxes[0].scatter(points[:2500, 0], points[:2500, 1], c=inside[:2500], s=4, cmap=\"coolwarm\")\naxes[0].set(aspect=\"equal\", xlabel=\"$x$\", ylabel=\"$y$\", title=\"Samples inside and outside the circle\")\naxes[1].semilogx(np.arange(1, inside.size + 1), running_pi, label=\"estimate\")\naxes[1].axhline(np.pi, color=\"k\", linestyle=\"--\", label=\"$\\\\pi$\")\naxes[1].set(xlabel=\"number of samples\", ylabel=\"estimate\", title=\"Monte Carlo convergence\")\naxes[1].legend(frameon=False)\nfig.tight_layout()\nplt.show()","key":"sE34JJI1Xx"},{"type":"outputs","id":"vc2BCCSmamNmWCw6ZClws","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"32af7d896ac140fc71a720c5df31fc64","path":"/chm696-site/build/32af7d896ac140fc71a720c5df31fc64.png"}}},"key":"FcaNy0nP9h"}],"key":"BPXWT2DEHb"}],"key":"mBlIpFL9he"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Relaxation of a Markov chain","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"kjGHSGFH8f"}],"identifier":"relaxation-of-a-markov-chain","label":"Relaxation of a Markov chain","html_id":"relaxation-of-a-markov-chain","implicit":true,"key":"Rs6vAhNvoS"}],"key":"Ch8AuPIeS8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"transition = np.array([[0.88, 0.22], [0.12, 0.78]])\nstate = np.array([1.0, 0.0])\nhistory = [state.copy()]\nfor _ in range(35):\n    state = transition @ state\n    history.append(state.copy())\nhistory = np.array(history)\n\nfig, ax = plt.subplots(figsize=(7, 4))\nax.plot(history[:, 0], \"o-\", label=\"state A\")\nax.plot(history[:, 1], \"o-\", label=\"state B\")\nax.set(xlabel=\"step\", ylabel=\"probability\", title=\"Approach to the stationary distribution\")\nax.legend(frameon=False)\nax.grid(alpha=0.2)\nplt.show()\n\nhistory[-1]","key":"YUDnqjugzM"},{"type":"outputs","id":"aLUWdMaXFccF9lvzlJhMp","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 700x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"ddcc1e525cf330449222feac453caee2","path":"/chm696-site/build/ddcc1e525cf330449222feac453caee2.png"}}},"key":"VcpafJlwmw"},{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"text/plain":{"content":"array([0.64705899, 0.35294101])","content_type":"text/plain"}}},"key":"tXsp2sxqqO"}],"key":"TxVoxUz3Fy"}],"key":"lRNHpirgyq"}],"key":"o4SIU3q9Iq"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Complex analysis with Python","url":"/computations/complex-analysis","group":"Computational notebooks"},"next":{"title":"Machine learning with Python","url":"/computations/machine-learning","group":"Computational notebooks"}}},"domain":"http://localhost:3000"}